# Copy to .env and fill in. Never commit real values.

# Public Supabase connection values. Publishable keys are safe for the browser
# only when Row Level Security and column privileges are correct.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side copies of the same public connection values, used during SSR.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never add a VITE_ prefix or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Absolute public URL used for Stripe return URLs. Production must use HTTPS.
PUBLIC_SITE_URL=http://127.0.0.1:4173
